{
  "name": "dsh-web3-repo",
  "private": true,
  "version": "0.1.0",
  "description": "Agent-safe EVM wallet for the DeepSeek Harness (DSH): encrypted local key vault, declarative signing policy, model tools, and web UI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dushudou/dsh-web3.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "lint": "pnpm -r --filter './packages/*' run lint",
    "all": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.30.2"
}
